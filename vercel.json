{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "envPrefix": "VITE_",
  "env": {
    "VITE_API_URL": "@vite_api_url"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
