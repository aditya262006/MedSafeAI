# MedSafeAI Environment Variables Template

# ── Backend Configurations ────────────────────────────────────────────────────
# Port to run FastAPI backend (default is 8000)
BACKEND_PORT=8000

# Optionally, add any external APIs if implemented in the future
# e.g., OPENAI_API_KEY=sk-...
# e.g., OPENFDA_API_KEY=...

# ── Frontend Configurations ───────────────────────────────────────────────────
# URL where backend is hosted
VITE_API_BASE_URL=http://localhost:8000
